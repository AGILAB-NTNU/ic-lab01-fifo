      "Date: $CURRENT_YEAR-$CURRENT_MONTH-$CURRENT_DATE",
      "Description: ${3:ShortDescription}",
      "\"\"\"",
      "",
      "$0"
    ],
    "description": "AGILAB 標準 Python 檔案標頭"
  }
}
